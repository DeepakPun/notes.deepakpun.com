---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

// Fetch posts, filter out everything except the 'en/' folder, and sort featured first, then by date
const notes: CollectionEntry<"note">[] = (await getCollection("note"))
  .filter((post) => post.id.startsWith("en/"))
  .sort((a: CollectionEntry<"note">, b: CollectionEntry<"note">) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  });
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      /* 1. Target the global body element across Astro's scoping barrier */
      :global(body) {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
      }

      /* 2. Force the main block to eat up all empty vertical space */
      main {
        flex: 1;
        width: 960px;
        max-width: 100%;
        margin: 0 auto;
        padding: 0 1rem;
        box-sizing: border-box;
      }
      ul {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 15px 0;
      }
      ul li {
        width: 100%;
      }
      /* Turns the link container into a side-by-side flex layout */
      ul li a {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        text-decoration: none;
        transition: 0.2s ease;
      }
      /* Limits the image size and makes it uniform */
      .image-wrapper {
        flex-shrink: 0;
        width: 180px;
        height: auto;
      }
      .image-wrapper img {
        width: 100%;
        height: auto;
        border-radius: 8px;
        display: block;
      }
      .post-details {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .title {
        margin: 0;
        color: rgb(var(--black));
        line-height: 1.2;
        font-size: 1.5rem;
      }
      .date {
        margin: 0;
        color: rgb(var(--gray));
      }

      /* --- Highlighted Featured Card Styling (Bluish Theme) --- */
      ul li.featured {
        background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
        border: 2px solid #2563eb;
        border-radius: 12px;
        padding: 1.25rem;
        box-sizing: border-box;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.12);
        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }
      ul li.featured:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.18);
      }
      .badge {
        align-self: flex-start;
        background-color: #1d4ed8;
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.25rem 0.65rem;
        border-radius: 6px;
        margin-bottom: 0.35rem;
      }
      ul li.featured .title {
        color: #0f172a;
      }
      ul li.featured a:hover .title {
        color: #1d4ed8;
      }
      .description {
        margin: 0.35rem 0 0;
        color: #334155;
        font-size: 0.95rem;
        line-height: 1.45;
      }
      /* Hover States */
      ul li a:hover h4,
      ul li a:hover .date {
        color: rgb(var(--accent));
      }
      ul a:hover img {
        box-shadow: var(--box-shadow);
      }

      /* Mobile Responsive Fix */
      @media (max-width: 600px) {
        ul li a {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.75rem;
        }
        .image-wrapper {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section>
        <ul>
          {notes.map((note) => (
            <li class:list={[{ featured: note.data.featured }]}>
              <a href={`/notes/${note.id}/`}>
                {note.data.heroImage && (
                  <div class="image-wrapper">
                    <Image
                      width={360}
                      height={180}
                      src={note.data.heroImage}
                      alt=""
                    />
                  </div>
                )}
                <div class="post-details">
                  {note.data.featured && (
                    <span class="badge">Featured Project • Microservices</span>
                  )}
                  <h4 class="title">{note.data.title}</h4>
                  <p class="date">
                    <FormattedDate date={note.data.pubDate} />
                  </p>
                  {note.data.featured && note.data.description && (
                    <p class="description">{note.data.description}</p>
                  )}
                </div>
              </a>
              {!note.data.featured && <hr />}
            </li>
          ))}
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
